{
  "name": "vortex-agent",
  "displayName": "Vortex",
  "description": "Seu agente de c\u00f3digo, seus modelos. BYOK para VS Code.",
  "version": "0.7.2",
  "publisher": "vortex-local",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p . && esbuild media/vendor-entry.js --bundle --platform=browser --format=iife --minify --outfile=media/vendor.js && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --target=node20 --outfile=dist/extension.js",
    "watch": "node scripts/watch.cjs",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "test:ui": "npm run compile && node test/ui.cjs",
    "test:host": "npm run compile && node test/extension-host.cjs",
    "test:tls": "npm run compile && node --test test/tls.cjs",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license --out vortex-agent.vsix",
    "icons": "node scripts/update-icons.cjs",
    "typecheck": "tsc -p . --noEmit",
    "test:real": "npm run compile && node scripts/evaluate.cjs",
    "test:sandbox": "npm run compile && node --test test/sandbox.cjs"
  },
  "activationEvents": [
    "onView:vortex.sidebar"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "vortex.open",
        "title": "Vortex: Abrir agente"
      },
      {
        "command": "vortex.openSettings",
        "title": "Vortex: Abrir configura\u00e7\u00f5es"
      },
      {
        "command": "vortex.reviewChanges",
        "title": "Vortex: Review task changes"
      },
      {
        "command": "vortex.undoChanges",
        "title": "Vortex: Undo task changes"
      },
      {
        "command": "vortex.attachContext",
        "title": "Vortex: Add to context"
      },
      {
        "command": "vortex.diagnostics",
        "title": "Vortex: Show diagnostic log"
      },
      {
        "command": "vortex.exportDiagnostics",
        "title": "Vortex: Preview diagnostic export"
      },
      {
        "command": "vortex.setupSandbox",
        "title": "Vortex: Download sandbox image"
      },
      {
        "command": "vortex.openLastFlow",
        "title": "Vortex: Open last AI flow (JSON)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vortex",
          "title": "Vortex",
          "icon": "media/vortex.svg"
        }
      ]
    },
    "views": {
      "vortex": [
        {
          "type": "webview",
          "id": "vortex.sidebar",
          "name": "Vortex"
        }
      ]
    },
    "configuration": {
      "title": "Vortex",
      "properties": {
        "vortex.sandbox.image": {
          "type": "string",
          "default": "node:22-bookworm-slim",
          "description": "Local Docker image for isolated commands. Pull or build it explicitly before use."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "vortex.attachContext",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "vortex.attachContext",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.0.0",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.46.0",
    "markdown-it": "^15.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "diff": "9.0.0",
    "undici": "^6.28.1"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/raulaguila/vortex.git"
  }
}
