{
  "name": "vortex-agent",
  "displayName": "Vortex",
  "description": "Seu agente de código, seus modelos. BYOK para VS Code.",
  "version": "0.3.0",
  "publisher": "vortex-local",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p . && esbuild media/vendor-entry.js --bundle --platform=browser --format=iife --minify --outfile=media/vendor.js && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --target=node20 --outfile=dist/extension.js",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "test:ui": "npm run compile && node test/ui.cjs",
    "test:host": "npm run compile && node test/extension-host.cjs",
    "test:tls": "npm run compile && node --test test/tls.cjs",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license --out vortex-agent.vsix",
    "icons": "node scripts/update-icons.cjs"
  },
  "activationEvents": [
    "onView:vortex.sidebar"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "vortex.open",
        "title": "Vortex: Abrir agente"
      },
      {
        "command": "vortex.openSettings",
        "title": "Vortex: Abrir configurações"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vortex",
          "title": "Vortex",
          "icon": "media/vortex.svg"
        }
      ]
    },
    "views": {
      "vortex": [
        {
          "type": "webview",
          "id": "vortex.sidebar",
          "name": "Vortex"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.0.0",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.46.0",
    "markdown-it": "^15.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "undici": "^6.28.1"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/raulaguila/vortex.git"
  }
}
